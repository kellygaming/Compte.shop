# Supabase (projet "compte-shop")
NEXT_PUBLIC_SUPABASE_URL=https://tqthhymhoagekfpbsker.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_veZ-TvLDn4odghW67ALjMw_dpfwDS7V

# Secret — jamais exposé au navigateur. Dashboard Supabase → Project
# Settings → API → service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=

# Sécurise /api/cron/release-expired-orders (Vercel Cron l'appelle avec ce
# secret en Authorization: Bearer ; en local, laisser vide désactive la
# vérification). Générer avec la même commande que ci-dessous.
CRON_SECRET=

# MoneyFusion — token marchand Compte.shop (espace marchand MoneyFusion,
# distinct de celui de kelly-gaming : ne jamais réutiliser le token d'un
# autre commerce, les règlements iraient sur le mauvais compte).
MONEYFUSION_MERCHANT_TOKEN=

# Segment secret et non devinable de l'URL de webhook (le webhook
# MoneyFusion n'est pas signé — voir src/app/api/webhooks/moneyfusion/).
# Générer avec: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MONEYFUSION_WEBHOOK_SECRET_PATH=

# Assistant de support (bouton flottant, visible connecté) — clé du
# tableau de bord DeepSeek (https://platform.deepseek.com/). Sans elle,
# l'assistant répond une erreur claire au lieu de planter.
DEEPSEEK_API_KEY=
